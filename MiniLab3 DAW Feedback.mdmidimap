{
    "format": "morningdaw-midimap",
    "version": 1,
    "name": "MiniLab3 DAW Feedback",
    "ports": ["minilab3 midi"],
    "output": "MorningDAW Feedback",
    "feedback": true,
    "bank": {"size": 8, "follows": true},
    "mappings": [
        {"in": "cc", "channel": 1, "number": 105, "target": "transport.loop"},
        {"in": "cc", "channel": 1, "number": 106, "target": "transport.stop"},
        {"in": "cc", "channel": 1, "number": 107, "target": "transport.play"},
        {"in": "cc", "channel": 1, "number": 108, "target": "transport.record"},
        {"in": "cc", "channel": 1, "number": 109, "target": "cmd:transport.tap_tempo"},
        {"in": "cc", "channel": 1, "number": 28, "encoding": "offset", "target": "transport.jog"},
        {"in": "note", "channel": 10, "number": 36, "target": "mixer.arm", "track": "bank:1"},
        {"in": "note", "channel": 10, "number": 37, "target": "mixer.arm", "track": "bank:2"},
        {"in": "note", "channel": 10, "number": 38, "target": "mixer.arm", "track": "bank:3"},
        {"in": "note", "channel": 10, "number": 39, "target": "mixer.arm", "track": "bank:4"},
        {"in": "note", "channel": 10, "number": 40, "target": "mixer.arm", "track": "bank:5"},
        {"in": "note", "channel": 10, "number": 41, "target": "mixer.arm", "track": "bank:6"},
        {"in": "note", "channel": 10, "number": 42, "target": "mixer.arm", "track": "bank:7"},
        {"in": "note", "channel": 10, "number": 43, "target": "mixer.arm", "track": "bank:8"},
        {"in": "cc", "channel": 1, "number": 14, "target": "mixer.volume", "track": "selected"},
        {"in": "cc", "channel": 1, "number": 31, "target": "mixer.pan", "track": "selected"},
        {"in": "cc", "channel": 1, "number": 86, "target": "mixer.volume", "track": "bank:1"},
        {"in": "cc", "channel": 1, "number": 87, "target": "mixer.volume", "track": "bank:2"},
        {"in": "cc", "channel": 1, "number": 89, "target": "mixer.volume", "track": "bank:3"},
        {"in": "cc", "channel": 1, "number": 90, "target": "mixer.volume", "track": "bank:4"},
        {"in": "cc", "channel": 1, "number": 110, "target": "mixer.volume", "track": "bank:5"},
        {"in": "cc", "channel": 1, "number": 111, "target": "mixer.volume", "track": "bank:6"},
        {"in": "cc", "channel": 1, "number": 116, "target": "mixer.volume", "track": "bank:7"},
        {"in": "cc", "channel": 1, "number": 117, "target": "mixer.volume", "track": "bank:8"}
    ]
}
